# Copy to .env.local (never commit real values). On Netlify, set the same names under
# Site configuration > Environment variables.

# Supabase - Project Settings > API. Use the secret / service_role key: server-only, never prefix with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=

# Resend - https://resend.com/api-keys
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "Sitora <contact@your-domain.com>"
CONSULTATION_FROM=
# Where new consultation requests are sent
CONSULTATION_TO=support@smoft.tn
Root123**koussay